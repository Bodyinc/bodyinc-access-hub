# Patient portal origin (password-reset redirects + email links)
PATIENT_PORTAL_URL=https://patient.example.com

# Optional: provider/admin app origin used in provider email deep links
# APP_URL=https://provider-sage.vercel.app
# PROVIDER_PORTAL_URL=https://provider-sage.vercel.app

# Brevo transactional email (server-side only)
# REST API key from Brevo → SMTP & API → API keys (xkeysib-). Do not put an SMTP key here.
BREVO_API_KEY=
# SMTP fallback (used when REST 401s on an unauthorized IP). LOGIN is the SMTP tab
# value like 12ab34001@smtp-brevo.com — NOT smtp-relay.brevo.com.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=ithelp@bodyinc.com
BREVO_SENDER_NAME=Body Inc
EMAIL_FROM="Body Inc <ithelp@bodyinc.com>"
# Public origin for reset links + email logo (no trailing slash).
# ADMIN_APP_URL=https://admin.bodyinc.com

# Life File Pharmacy API - Sandbox (server-side only)
# Use the API username/password (sandboxapi...), not the pharmacy portal login.
# Vite expands $VAR in .env. If the password contains $ or #, double-quote it
# and escape dollar signs: LIFE_FILE_API_PASSWORD="p@ss\$word#here"
# Hosted env dashboards (Vercel/Lovable) are literal — do not include the backslash there.
LIFE_FILE_API_BASE_URL=https://host27a.lifefile.net:10165/lfapi/v1
LIFE_FILE_API_USERNAME=
LIFE_FILE_API_PASSWORD=
